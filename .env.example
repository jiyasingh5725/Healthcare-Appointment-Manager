# ==============================================================================
# CareSync Healthcare Platform - Environment Configuration Template
# ==============================================================================

# Application Settings
APP_NAME="CareSync Healthcare Appointment & Follow-up Manager"
APP_ENV=production
DEBUG=False
HOST=0.0.0.0
PORT=8000

# CORS Allowed Origins (Comma-separated URLs)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://yourdomain.com

# Database Connection (MySQL / PostgreSQL / SQLite)
# For MySQL: mysql+pymysql://<user>:<password>@<host>:3306/<database>
# For SQLite: sqlite:///healthcare_manager.db
DATABASE_URL=mysql+pymysql://caresync_user:secure_password@127.0.0.1:3306/healthcare_manager

# Security & JWT Authentication
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_this_to_a_secure_random_secret_key_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Google Gemini AI Configuration
GEMINI_API_KEY=your_gemini_api_key_here
LLM_PROVIDER=gemini
LLM_MODEL_NAME=gemini-1.5-flash

# Redis & Celery Background Queue
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0

# Multichannel Email Notification Service ('mock', 'smtp', 'sendgrid', 'mailgun')
EMAIL_PROVIDER=mock
EMAIL_FROM=noreply@caresync-health.org
EMAIL_FROM_NAME=CareSync Health Notifications

# SMTP Configuration (if EMAIL_PROVIDER=smtp)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=your_smtp_password_here
SMTP_TLS=True

# Third-Party Email APIs (if using SendGrid or Mailgun)
SENDGRID_API_KEY=SG.your_sendgrid_api_key_here
MAILGUN_API_KEY=key-your_mailgun_api_key_here
MAILGUN_DOMAIN=mg.yourdomain.com

# Google Calendar API & OAuth 2.0 Integration
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-yourGoogleClientSecretHere
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/calendar/callback
# GOOGLE_CALENDAR_MODE ('mock' for testing without live credentials, 'live' for production)
GOOGLE_CALENDAR_MODE=mock
